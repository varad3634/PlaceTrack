# PlaceTrack Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/placetrack?retryWrites=true&w=majority
# For Local MongoDB: mongodb://localhost:27017/placetrack
# If left as 'memory' or if local Mongo is unavailable in dev, an in-memory Mongo database starts automatically
MONGODB_URI=memory

# JWT Configuration
JWT_SECRET=placetrack_super_secret_jwt_key_2026_academic_demo
JWT_EXPIRE=7d

# CORS Configuration
CLIENT_URL=http://localhost:5173
